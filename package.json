{
  "name": "dashboard-relatorios",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:dev": "tsx --env-file=.env scripts/dev-db.ts",
    "db:migrate": "tsx --env-file=.env scripts/migrate.ts",
    "db:migrate:supabase": "tsx --env-file=.env scripts/migrate.ts --supabase",
    "hooks:install": "git config core.hooksPath .githooks",
    "google:auth": "tsx --env-file=.env scripts/google-auth.ts",
    "check:credentials": "tsx --env-file=.env scripts/check-credentials.ts",
    "user:create": "tsx --env-file=.env scripts/create-user.ts"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.10.0",
    "bcryptjs": "^3.0.2",
    "jose": "^6.1.0",
    "next": "^16.4.6",
    "pg": "^8.16.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^3.2.1",
    "server-only": "^0.0.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "embedded-postgres": "18.6.0-beta.19",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
