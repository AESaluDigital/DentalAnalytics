# Copie para .env e preencha. O .env NUNCA vai para o git.

# --- App ---
# URL pública do app (usada para montar o link de compartilhamento)
APP_URL=http://localhost:3000
# Segredo da sessão: no mínimo 32 caracteres aleatórios.
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
# Validade do link público de relatório, em dias (0 = sem expiração)
SHARE_LINK_DAYS=90

# Logins que são SEMPRE administradores (conta master), separados por vírgula.
MASTER_ADMINS=

# "true" gera relatórios com DADOS FICTÍCIOS, sem chamar Meta/Google (para testes).
# Desligue (false) quando os tokens abaixo estiverem preenchidos.
DEMO_MODE=false

# --- Banco ---
DATABASE_URL=postgres://usuario:senha@localhost:5432/dashboard
# "true" exige SSL com certificado válido; "no-verify" usa SSL sem validar a cadeia (Supabase); "false" sem SSL
DATABASE_SSL=false

# Chave que criptografa os tokens das Integrações no banco (32 bytes base64url).
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Se trocar esta chave, será preciso reconectar Meta e Google.
INTEGRATIONS_KEY=

# --- Meta (Marketing API) ---
# Recomendado: conectar pela tela Integrações (precisa de META_APP_ID + META_APP_SECRET).
META_APP_ID=
META_APP_SECRET=
# Opcional: ID da configuração do "Login do Facebook para Empresas" (marque ads_read e business_management)
META_LOGIN_CONFIG_ID=
# Alternativa: token fixo de System User (ads_read + business_management). Usado só se não houver conexão na tela.
META_ACCESS_TOKEN=
META_API_VERSION=v26.0

# --- Google (Ads + GA4) ---
# Cliente OAuth do tipo "Aplicativo da Web", com a URI de redirecionamento
#   {APP_URL}/api/integrations/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Alternativa à tela Integrações: refresh token fixo (npm run google:auth).
GOOGLE_REFRESH_TOKEN=
GOOGLE_ADS_DEVELOPER_TOKEN=
# ID da conta MCC (10 dígitos, sem hífen). Deixe vazio se não usar MCC.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_API_VERSION=v26

# --- Claude (somente textos de análise) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
